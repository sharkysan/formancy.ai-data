{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["FORMANCY_IMAGES"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "env": ["FORMANCY_IMAGES"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "check:pkg": {
      "dependsOn": ["build"]
    },
    "test:browser": {
      "dependsOn": ["build"],
      "passThroughEnv": ["FORMANCY_BROWSERS", "PLAYWRIGHT_BROWSERS_PATH"],
      "cache": false
    },
    "test:pictures": {
      "dependsOn": ["build"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"],
      "cache": false
    }
  }
}
