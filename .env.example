# Copy to `.env` and fill in. `docker compose up` refuses to start SQL Server
# without a password, which is the point: a database that boots with a password
# printed in its own repository is a database anyone who has read the repository
# can sign in to.
#
#   cp .env.example .env
#
# `.env` is gitignored. Do not commit it.

# SQL Server's `sa` password. The server enforces the policy itself: at least
# eight characters from three of the four classes (upper, lower, digit, symbol),
# and it refuses to start -- quietly, with the container restarting -- on one
# that does not meet it.
MSSQL_SA_PASSWORD=

# The development PostgreSQL password. Both databases are bound to 127.0.0.1, so
# these are weaker secrets than a production one -- but still passwords.
# POSTGRES_PASSWORD=formancy
