{
  "name": "@formancy/data-client",
  "version": "0.1.0",
  "description": "The browser's side of Formancy Data's runtime plane: a fetch-based client for a published form's records and lookups, and option sources both formancy renderers take. Framework-neutral, no Node.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "test:coverage": "vitest run --coverage",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "check:pkg": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@formancy/data-core": "workspace:*",
    "@formancy/spec": "0.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@formancy/core": "0.3.0",
    "@formancy/data-fixtures": "workspace:*",
    "@formancy/data-server": "workspace:*",
    "@types/mssql": "^12.3.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jose": "^6.2.12",
    "mssql": "^12.0.0",
    "postgres": "^3.4.9",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unrun": "^0.3.1",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharkysan/formancy.ai-data.git",
    "directory": "packages/data-client"
  },
  "homepage": "https://github.com/sharkysan/formancy.ai-data",
  "bugs": "https://github.com/sharkysan/formancy.ai-data/issues"
}
