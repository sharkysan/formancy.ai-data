{
  "name": "@formancy/data-server",
  "version": "0.1.0",
  "description": "The Formancy Data server: the configuration store, host identity and the HTTP surface the adapters sit behind. Fastify, like formancy's own server.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "test:coverage": "vitest run --coverage",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:pkg": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@formancy/data-core": "workspace:*",
    "@formancy/data-postgres": "workspace:*",
    "@formancy/data-sqlserver": "workspace:*",
    "@formancy/spec": "0.4.0",
    "fastify": "^5.12.5",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@formancy/data-fixtures": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unrun": "^0.3.1",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharkysan/formancy.ai-data.git",
    "directory": "packages/data-server"
  },
  "homepage": "https://github.com/sharkysan/formancy.ai-data",
  "bugs": "https://github.com/sharkysan/formancy.ai-data/issues"
}
