{
  "name": "@formancy/data-host",
  "version": "0.1.0",
  "private": true,
  "description": "A host application's page over the data server's runtime plane: one published form, loaded, edited, saved and searched under @formancy/react and @formancy/angular side by side, through @formancy/data-client. An example, never published.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "test": "vitest run",
    "test:browser": "node scripts/browser-test.mjs && node scripts/pictures.mjs --check",
    "pictures": "node scripts/pictures.mjs"
  },
  "dependencies": {
    "@angular/common": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@formancy/angular": "0.4.0",
    "@formancy/core": "0.4.0",
    "@formancy/data-client": "workspace:*",
    "@formancy/react": "0.4.0",
    "@formancy/spec": "0.4.0",
    "@formancy/themes": "0.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.2",
    "@angular/build": "^22.1.8",
    "@angular/compiler": "^22.1.7",
    "@angular/compiler-cli": "^22.1.7",
    "@formancy/conformance": "0.4.0",
    "@formancy/data-core": "workspace:*",
    "@formancy/data-fixtures": "workspace:*",
    "@formancy/data-server": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mssql": "^12.3.0",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "catalog:",
    "dom-accessibility-api": "^0.5.16",
    "jsdom": "^30.1.0",
    "mssql": "^12.0.0",
    "playwright": "catalog:",
    "postgres": "^3.4.9",
    "typescript": "catalog:",
    "vite": "^8.3.0",
    "vitest": "catalog:"
  }
}
