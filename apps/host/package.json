    "@fontsource/ibm-plex-mono": "catalog:",
    "@fontsource/ibm-plex-sans": "catalog:",
    "@formancy/angular": "0.6.0",
    "@formancy/core": "0.6.0",
    "@formancy/data-client": "workspace:*",
    "@formancy/react": "0.6.0",
    "@formancy/spec": "0.6.0",
    "@formancy/themes": "0.6.0",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "^7.8.2"
