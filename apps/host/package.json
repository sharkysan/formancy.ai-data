{
  "name": "@formancy/data-host",
  "version": "0.2.0",
  "private": true,
  "description": "A host application's workspace over the data server's runtime plane: the forms a person may read, a form's records in an AG Grid Community grid, a record under @formancy/react, @formancy/angular or both, and its child rows, through @formancy/data-client. An example, never published.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo --base ./ --outDir dist-demo",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "test": "vitest run",
    "test:browser": "node scripts/browser-test.mjs",
    "test:pictures": "node scripts/pictures.mjs --check",
    "pictures": "node scripts/pictures.mjs"
  },
  "dependencies": {
